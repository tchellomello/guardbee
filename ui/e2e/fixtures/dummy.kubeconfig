# Points at nothing (port 1): the e2e suite runs the real `guardbee ui`
# with no cluster. Endpoints that need one are mocked per test
# (fixtures/test.ts); everything else — policy parse/validate, templates,
# compat, flow-filter options, the static UI — is the real binary.
apiVersion: v1
kind: Config
clusters: [{ name: none, cluster: { server: "https://127.0.0.1:1" } }]
users: [{ name: none, user: {} }]
contexts: [{ name: e2e, context: { cluster: none, user: none } }]
current-context: e2e
